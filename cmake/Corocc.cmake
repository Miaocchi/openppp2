option(ENABLE_COROCC "Use the experimental corocc L0 coroutine backend" OFF)
option(COROCC_FORCE "Allow corocc on an experimental platform" OFF)
option(PPP_COROCC_GUARD_STACK "Allocate corocc stacks with a guard page" OFF)
get_filename_component(_ppp_root "${CMAKE_CURRENT_LIST_DIR}/.." ABSOLUTE)
set(COROCC_SOURCE_DIR "${_ppp_root}/third-party/corocc" CACHE PATH "Pinned corocc source tree")

if(ENABLE_COROCC)
    if(IOS OR CMAKE_SYSTEM_NAME STREQUAL "iOS")
        message(WARNING "corocc is unsupported on iOS; using Boost fcontext")
        set(ENABLE_COROCC OFF CACHE BOOL "" FORCE)
    elseif(NOT (CMAKE_SIZEOF_VOID_P EQUAL 8 AND ((CMAKE_SYSTEM_NAME MATCHES "^(Linux|Darwin|Android)$"
            AND CMAKE_SYSTEM_PROCESSOR MATCHES "^(x86_64|AMD64|aarch64|arm64)$")
            OR (WIN32 AND MSVC AND CMAKE_SIZEOF_VOID_P EQUAL 8
            AND NOT CMAKE_SYSTEM_PROCESSOR MATCHES "ARM|arm|aarch"
            AND NOT CMAKE_GENERATOR_PLATFORM MATCHES "ARM|arm"
            AND NOT CMAKE_CXX_COMPILER_ARCHITECTURE_ID MATCHES "ARM|arm"))))
        if(COROCC_FORCE)
            message(WARNING "Forcing experimental corocc platform; no runtime fallback")
        else()
            message(WARNING "corocc platform is outside the whitelist; using Boost (COROCC_FORCE overrides)")
            set(ENABLE_COROCC OFF CACHE BOOL "" FORCE)
        endif()
    endif()
endif()

if(ENABLE_COROCC)
    if(NOT EXISTS "${COROCC_SOURCE_DIR}/include/corocc/coro_ctx.h")
        message(FATAL_ERROR "corocc source missing: run bash tools/prepare_corocc.sh or set COROCC_SOURCE_DIR")
    endif()
    enable_language(C)
    set(COROCC_BUILD_TESTS OFF CACHE BOOL "" FORCE)
    set(COROCC_BUILD_EXAMPLES OFF CACHE BOOL "" FORCE)
    set(COROCC_RT_DRIVER OFF CACHE BOOL "" FORCE)
    # The transfer adapter owns the fiber lifecycle, including terminal jumps.
    # Do not combine its hooks with the upstream L0 ASan hooks.
    set(COROCC_ASAN OFF CACHE BOOL "" FORCE)
    set(COROCC_TSAN ${ENABLE_TSAN} CACHE BOOL "" FORCE)
    add_subdirectory("${COROCC_SOURCE_DIR}" "${CMAKE_CURRENT_BINARY_DIR}/corocc" EXCLUDE_FROM_ALL)
    # Android embeds this static archive in libopenppp2.so.
    set_target_properties(corocc PROPERTIES POSITION_INDEPENDENT_CODE ON)
    if(MSVC)
        target_compile_options(corocc PRIVATE "$<$<COMPILE_LANGUAGE:C,CXX>:/WX->")
    else()
        target_compile_options(corocc PRIVATE -Wno-error)
    endif()
    add_library(ppp_context_backend INTERFACE)
    target_link_libraries(ppp_context_backend INTERFACE corocc)
    target_compile_definitions(ppp_context_backend INTERFACE PPP_COROUTINE_BACKEND_COROCC=1)
    if(ENABLE_TSAN)
        # coro_ctx's fiber field is an ABI choice, including in consumers
        # whose translation units do not themselves enable instrumentation.
        target_compile_definitions(ppp_context_backend INTERFACE COROCC_TSAN=1)
    endif()
    if(ENABLE_ASAN OR ENABLE_SANITIZERS)
        target_compile_definitions(ppp_context_backend INTERFACE PPP_COROUTINES_ASAN_ENABLED=1)
        if(MSVC)
            target_compile_options(corocc PRIVATE /fsanitize=address)
        else()
            target_compile_options(corocc PRIVATE -fsanitize=address -fno-omit-frame-pointer)
        endif()
    endif()
    if(PPP_COROCC_GUARD_STACK)
        target_compile_definitions(ppp_context_backend INTERFACE PPP_COROCC_GUARD_STACK=1)
    endif()
    message(STATUS "Coroutine backend: corocc L0 (experimental)")
else()
    message(STATUS "Coroutine backend: boost-fcontext")
endif()
