{
  "schema": 1,
  "cases": [
    {
      "id": "configuration_nested_wins",
      "kind": "configuration",
      "input": {
        "config": {
          "client": {
            "proxy-only": false,
            "routes": [
              {
                "ngw": "203.0.113.1",
                "path": "legacy"
              }
            ],
            "routing": {
              "mode": "proxy",
              "bypass": "alias",
              "dns-rules": "alias-dns",
              "ip": {
                "bypass": [
                  " 192.0.2.0/24 ",
                  "",
                  7
                ],
                "routes": [
                  {
                    "ngw": "192.0.2.1",
                    "path": "test-route"
                  }
                ],
                "peer-routes": [
                  {
                    "network": "198.51.100.0",
                    "prefix": 24,
                    "via": "192.0.2.2",
                    "guid": "test-peer"
                  }
                ]
              },
              "dns": {
                "rules": " example.test/192.0.2.53/tun "
              }
            }
          },
          "routing": {
            "rules": "priority.rules",
            "tcp-domain-sniff": true
          }
        }
      },
      "expected": {
        "configured": true,
        "proxy_only": false,
        "rules": "priority.rules",
        "sniff": true,
        "legacy_routes": 1,
        "legacy_peer_routes": 1,
        "legacy_routes_emitted": false,
        "roundtrip": true,
        "canonical": {
          "ip": {
            "bypass": [
              "192.0.2.0/24"
            ],
            "routes": [
              {
                "ngw": "192.0.2.1",
                "path": "test-route",
                "vbgp": ""
              }
            ],
            "peer-routes": [
              {
                "network": "198.51.100.0",
                "prefix": 24,
                "via": "192.0.2.2",
                "guid": "test-peer"
              }
            ]
          },
          "dns": {
            "rules": [
              "example.test/192.0.2.53/tun"
            ]
          }
        }
      }
    },
