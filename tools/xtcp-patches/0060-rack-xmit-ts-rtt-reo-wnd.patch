diff --git a/tests/test_rack_xmit_ts.cpp b/tests/test_rack_xmit_ts.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_rack_xmit_ts.cpp
@@ -0,0 +1,260 @@
+/**
+ * @file test_rack_xmit_ts.cpp
+ * @brief RFC 8985 RACK uses the SEND time of the most recently delivered
+ *        segment (RACK.xmit_ts) and its RTT: a segment is lost only when a
+ *        later-sent segment was delivered AND now >= xmit_ts + RACK.rtt +
+ *        reo_wnd. Measuring from the ACK arrival (the old rule) marked any
+ *        in-flight segment that was about one RTT old as lost the moment a
+ *        later segment was SACKed.
+ *
+ * The link is given a real ~20 ms RTT (10 ms sleep per direction) so that
+ * min_rtt/4 (the reorder window, ~5 ms) is far above the microsecond
+ * transmit gaps and far below the multi-RTT RTO.
+ *
+ * Scenarios (A = sender, B = receiver):
+ *   a  two segments sent back to back, the SECOND delivered first (reorder
+ *      within the reorder window): the first must NOT be marked lost - no
+ *      retransmit, no cwnd cut. (The old rule retransmitted at once.)
+ *   b  two segments sent 15 ms apart, the first lost: once the later one is
+ *      SACKed the first IS lost (xmit gap >= reo_wnd) and is retransmitted
+ *      without waiting for the dup-ACK threshold or the RTO.
+ *   c  a segment sent right after that retransmission is SACKed while the
+ *      retransmission is outstanding: the retransmitted segment (its
+ *      sent_at is Karn-zeroed) is not re-marked / re-sent immediately.
+ */
+
+#include <xtcp/buf/bufref.h>
+#include <xtcp/core/stack.h>
+#include <xtcp/ndi/manual.h>
+
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+static int g_failures = 0;
+
+#define CHECK(cond)                                                           \
+    do {                                                                      \
+        if (!(cond)) {                                                        \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); \
+            ++g_failures;                                                     \
+        }                                                                     \
+    } while (0)
+
+static void SleepMs(int ms) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(ms));
+}
+
+int main() {
+    xtcp::buf::InitPools();
+    {
+        xtcp::ndi::ManualBackend backend_a, backend_b;
+        xtcp::XtcpStack stack_a(&backend_a);
+        xtcp::XtcpStack stack_b(&backend_b);
+        stack_a.SetDefaultCongestionControl("");
+        backend_a.SetRxHandler([&stack_a](xtcp::ndi::Packet&& p) {
+            xtcp::buf::BufRef buf = xtcp::buf::BufRef::Acquire(p.len);
+            std::memcpy(buf.Data(), p.data, p.len);
+            buf.SetLen(p.len);
+            stack_a.OnPacket(std::move(buf));
+        });
+        backend_b.SetRxHandler([&stack_b](xtcp::ndi::Packet&& p) {
+            xtcp::buf::BufRef buf = xtcp::buf::BufRef::Acquire(p.len);
+            std::memcpy(buf.Data(), p.data, p.len);
+            buf.SetLen(p.len);
+            stack_b.OnPacket(std::move(buf));
+        });
+        std::atomic<UInt64> b_recv{0};
+        stack_b.SetRecvHandler([&b_recv](UInt64, const Byte*, UInt32 len) {
+            b_recv.fetch_add(len, std::memory_order_relaxed);
+            return true;
+        });
+
+        struct Frame {
+            std::vector<Byte> bytes;
+            bool Data() const { return 1000 <= bytes.size(); }
+        };
+        auto drain = [](xtcp::ndi::ManualBackend& be) {
+            std::vector<Frame> v;
+            Byte out[65536];
+            while (0 != be.TxPending()) {
+                const UInt32 n = be.PollTx(out);
+                if (0 < n) {
+                    Frame f;
+                    f.bytes.assign(out, out + n);
+                    v.push_back(std::move(f));
+                }
+            }
+            return v;
+        };
+        auto inject = [](xtcp::ndi::ManualBackend& be, const Frame& f) {
+            be.Inject(f.bytes.data(), static_cast<UInt32>(f.bytes.size()), 0x0800);
+        };
+        // Inject a frame into B, let B's (possibly deferred) dup-ACK timer
+        // fire, then return the ACK frames after a 10 ms one-way delay.
+        auto deliver_and_collect = [&](const Frame& f) {
+            inject(backend_b, f);
+            stack_b.PollAckTimers();
+            SleepMs(2);
+            stack_b.PollAckTimers();
+            SleepMs(10);
+            stack_b.PollAckTimers();
+            return drain(backend_b);
+        };
+        // One full round trip with a 10 ms one-way delay.
+        auto step = [&]() {
+            SleepMs(10);
+            for (const Frame& f : drain(backend_a)) inject(backend_b, f);
+            stack_b.PollAckTimers();
+            SleepMs(10);
+            for (const Frame& f : drain(backend_b)) inject(backend_a, f);
+            stack_a.PollAckTimers();
+        };
+
+        xtcp::core::Endpoint server_ep, client_ep;
+        server_ep.family = 4;
+        server_ep.addr[0] = 0x0A000001;
+        server_ep.port = 443;
+        client_ep.family = 4;
+        client_ep.addr[0] = 0xC0A80102;
+        client_ep.port = 40000;
+        CHECK(stack_b.Listen(server_ep));
+        const UInt64 conn = stack_a.Connect(client_ep, server_ep);
+        CHECK(0 != conn);
+        for (UInt32 i = 0; i < 50 && xtcp::core::TcpState::kEstablished != stack_a.ConnectionState(conn); ++i) {
+            step();
+        }
+        CHECK(xtcp::core::TcpState::kEstablished == stack_a.ConnectionState(conn));
+
+        const UInt32 kSeg = stack_a.ConnPayloadCap(conn);
+        std::vector<Byte> payload(kSeg * 64, 0x4D);
+        UInt64 total = 0;
+        auto send_seg = [&]() {
+            const bool ok = stack_a.Send(conn, payload.data(), kSeg);
+            if (ok) total += kSeg;
+            return ok;
+        };
+        auto drain_all = [&]() {
+            for (UInt32 i = 0; i < 200 && (b_recv.load() < total ||
+                                           0 < stack_a.ConnOutstandingSegments(conn)); ++i) {
+                step();
+            }
+        };
+
+        // Warm-up: grow cwnd and seed srtt/min_rtt with ~20 ms samples.
+        for (UInt32 i = 0; i < 24; ++i) {
+            SleepMs(2);
+            if (!send_seg()) step();
+        }
+        drain_all();
+        CHECK(total == b_recv.load());
+        CHECK(0 == stack_a.ConnOutstandingSegments(conn));
+        xtcp::XtcpStack::ConnInfo info;
+        CHECK(stack_a.ConnGetInfo(conn, info));
+        CHECK(10000 < info.rtt_us);  // the delayed link was measured
+
+        // Collect up to `want` data frames the sender has emitted.
+        auto take_data = [&](UInt32 want) {
+            std::vector<Frame> got;
+            for (UInt32 i = 0; i < 20 && got.size() < want; ++i) {
+                stack_a.PollAckTimers();
+                for (Frame& f : drain(backend_a)) {
+                    if (f.Data()) got.push_back(std::move(f));
+                }
+                if (got.size() < want) SleepMs(1);
+            }
+            return got;
+        };
+
+        // ---- a: reordered pair, second delivered first -------------------
+        {
+            xtcp::XtcpStack::ConnInfo pre;
+            CHECK(stack_a.ConnGetInfo(conn, pre));
+            const UInt32 retx0 = stack_a.ConnRetransmitCount(conn);
+            SleepMs(2);
+            CHECK(send_seg());
+            SleepMs(2);
+            CHECK(send_seg());
+            std::vector<Frame> f = take_data(2);
+            CHECK(2 == f.size());
+            if (2 == f.size()) {
+                SleepMs(10);
+                std::vector<Frame> acks = deliver_and_collect(f[1]);  // later segment first
+                CHECK(!acks.empty());                                 // the SACK ACK exists
+                for (const Frame& a : acks) inject(backend_a, a);
+                stack_a.PollAckTimers();
+                xtcp::XtcpStack::ConnInfo mid;
+                CHECK(stack_a.ConnGetInfo(conn, mid));
+                CHECK(retx0 == stack_a.ConnRetransmitCount(conn));  // not marked lost
+                CHECK(pre.cwnd <= mid.cwnd);                        // no spurious cut
+                inject(backend_b, f[0]);           // the reordered one arrives
+            }
+            drain_all();
+            CHECK(total == b_recv.load());
+            CHECK(retx0 == stack_a.ConnRetransmitCount(conn));
+            std::fprintf(stderr, "[rack_xmit] a: reorder absorbed, retx %u\n",
+                         stack_a.ConnRetransmitCount(conn));
+        }
+
+        // ---- b + c: real loss, then no immediate re-mark ------------------
+        {
+            const UInt32 retx0 = stack_a.ConnRetransmitCount(conn);
+            SleepMs(2);
+            CHECK(send_seg());                      // f3: will be lost
+            std::vector<Frame> lost = take_data(1);
+            CHECK(1 == lost.size());
+            // Gap >= SRTT >= reo_wnd (reo_wnd is capped at SRTT).
+            xtcp::XtcpStack::ConnInfo cur;
+            CHECK(stack_a.ConnGetInfo(conn, cur));
+            std::fprintf(stderr, "[rack_xmit] srtt=%u cwnd=%u ssthresh=%u\n", cur.rtt_us, cur.cwnd, cur.ssthresh);
+            SleepMs(static_cast<int>(cur.rtt_us / 1000) + 10);
+            CHECK(send_seg());                      // f4: delivered
+            std::vector<Frame> later = take_data(1);
+            CHECK(1 == later.size());
+            if (1 == lost.size() && 1 == later.size()) {
+                SleepMs(10);
+                std::vector<Frame> acks = deliver_and_collect(later[0]);
+                CHECK(!acks.empty());
+                for (const Frame& a : acks) inject(backend_a, a);
+                stack_a.PollAckTimers();
+                const UInt32 retx1 = stack_a.ConnRetransmitCount(conn);
+                xtcp::XtcpStack::ConnInfo post;
+                CHECK(stack_a.ConnGetInfo(conn, post));
+                std::fprintf(stderr, "[rack_xmit] after SACK: cwnd=%u ssthresh=%u\n", post.cwnd, post.ssthresh);
+                CHECK(retx0 < retx1);               // marked lost after RTT + reo_wnd
+                std::vector<Frame> rtx = take_data(1);
+                CHECK(1 == rtx.size());
+                std::fprintf(stderr, "[rack_xmit] b: real loss retx %u -> %u\n", retx0, retx1);
+
+                // c: send another segment right behind the retransmission and
+                // SACK it while the retransmission is still in flight.
+                SleepMs(2);
+                CHECK(send_seg());
+                std::vector<Frame> f5 = take_data(1);
+                CHECK(1 == f5.size());
+                if (1 == f5.size()) {
+                    SleepMs(10);
+                    std::vector<Frame> acks = deliver_and_collect(f5[0]);
+                    CHECK(!acks.empty());
+                    for (const Frame& a : acks) inject(backend_a, a);
+                    stack_a.PollAckTimers();
+                    CHECK(retx1 == stack_a.ConnRetransmitCount(conn));  // not re-marked
+                }
+                if (1 == rtx.size()) {
+                    inject(backend_b, rtx[0]);
+                }
+            }
+            drain_all();
+            CHECK(total == b_recv.load());
+            std::fprintf(stderr, "[rack_xmit] c: recv=%llu/%llu retx=%u\n",
+                         (unsigned long long)b_recv.load(), (unsigned long long)total,
+                         stack_a.ConnRetransmitCount(conn));
+        }
+    }
+    xtcp::buf::ShutdownPools();
+    std::fprintf(stderr, g_failures ? "RACK_XMIT_TS: FAILED (%d)\n" : "RACK_XMIT_TS: ALL PASSED\n", g_failures);
+    return g_failures ? 1 : 0;
+}
diff --git a/tests/test_sack_scoreboard.cpp b/tests/test_sack_scoreboard.cpp
new file mode 100644
--- /dev/null
+++ b/tests/test_sack_scoreboard.cpp
@@ -0,0 +1,246 @@
+/**
+ * @file test_sack_scoreboard.cpp
+ * @brief SACK scoreboard accounting.
+ *   s1  A partial SACK block re-advertised in 3 dup-ACKs is counted ONCE:
+ *       the segment's SACKed bytes stay at the block size (the old
+ *       `sacked += overlap` re-added it each time until the segment looked
+ *       fully SACKed). An overlapping/adjacent block only adds the new bytes.
+ *   s2  The hole check (SackFrontierOffset, used by the dup-ACK reordering
+ *       gate and the zero-info guard) is correct for blocks straddling the
+ *       2^32 sequence wrap.
+ */
+
+#include <xtcp/core/stack.h>
+#include <xtcp/core/tcp.h>
+#include <xtcp/ndi/manual.h>
+#include "harness/raw_pkt.h"
+
+#include <chrono>
+#include <cstdio>
+#include <cstring>
+#include <thread>
+#include <vector>
+
+static int g_failures = 0;
+
+#define CHECK(cond)                                                       \
+    do {                                                                  \
+        if (!(cond)) {                                                    \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); \
+            ++g_failures;                                                 \
+        }                                                                 \
+    } while (0)
+
+namespace {
+    using xtcp::harness::FillIp4Checksum;
+    using xtcp::harness::FillTcp4Checksum;
+
+    /** Raw ACK from B's tuple with optional SACK blocks ([left,right) pairs,
+     *  already absolute sequence numbers). */
+    static std::vector<Byte> BuildAckWithSack(UInt32 ack, const UInt32* sack_pairs, UInt32 n_pairs) {
+        // Full size up front (20 IP + 20 TCP + padded options): resize after
+        // taking pointers would invalidate them via reallocation.
+        const UInt32 opt_len = (0 < n_pairs) ? (2 + 8 * n_pairs) : 0;
+        const UInt32 padded = (opt_len + 3) & ~3u;
+        std::vector<Byte> out(40 + padded, 0);
+        Byte* ip = out.data();
+        ip[0] = 0x45;
+        const UInt32 total = static_cast<UInt32>(out.size());
+        ip[2] = static_cast<Byte>(total >> 8);
+        ip[3] = static_cast<Byte>(total & 0xFF);
+        ip[8] = 64;
+        ip[9] = 6;
+        ip[12] = 0x0A; ip[13] = 0x00; ip[14] = 0x00; ip[15] = 0x02;  // B
+        ip[16] = 0x0A; ip[17] = 0x00; ip[18] = 0x00; ip[19] = 0x01;  // A
+        Byte* t = ip + 20;
+        t[0] = 0x23; t[1] = 0x82;  // sport 9090
+        t[2] = 0x9C; t[3] = 0x7D;  // dport 40061
+        t[4] = t[5] = t[6] = t[7] = 0x50;  // seq (in window)
+        t[8] = static_cast<Byte>(ack >> 24); t[9] = static_cast<Byte>(ack >> 16);
+        t[10] = static_cast<Byte>(ack >> 8); t[11] = static_cast<Byte>(ack & 0xFF);
+        t[12] = static_cast<Byte>(((20 + padded) / 4) << 4);  // data offset
+        t[13] = 0x10;  // ACK
+        t[14] = 0xFF; t[15] = 0xFF;
+        // TCP options: kind=5 (SACK), len=10, two edges per block, then
+        // NOP padding so the header is 4-byte aligned.
+        if (0 < n_pairs) {
+            Byte* opt = t + 20;
+            opt[0] = 5;
+            opt[1] = static_cast<Byte>(opt_len);
+            for (UInt32 i = 0; i < n_pairs; ++i) {
+                Byte* e = opt + 2 + 8 * i;
+                e[0] = static_cast<Byte>(sack_pairs[2 * i] >> 24);
+                e[1] = static_cast<Byte>(sack_pairs[2 * i] >> 16);
+                e[2] = static_cast<Byte>(sack_pairs[2 * i] >> 8);
+                e[3] = static_cast<Byte>(sack_pairs[2 * i] & 0xFF);
+                e[4] = static_cast<Byte>(sack_pairs[2 * i + 1] >> 24);
+                e[5] = static_cast<Byte>(sack_pairs[2 * i + 1] >> 16);
+                e[6] = static_cast<Byte>(sack_pairs[2 * i + 1] >> 8);
+                e[7] = static_cast<Byte>(sack_pairs[2 * i + 1] & 0xFF);
+            }
+            for (UInt32 i = opt_len; i < padded; ++i) {
+                opt[i] = 1;  // NOP padding
+            }
+        }
+        FillIp4Checksum(ip);
+        FillTcp4Checksum(ip, t, static_cast<UInt32>(20 + padded));
+        return out;
+    }
+
+    /** Pumps A's tx into B ONLY (B's ACKs stay queued): keeps A's data in
+     *  retrans_queue_ while raw dup-ACKs are injected. */
+    static void PumpOneWay(xtcp::ndi::ManualBackend& a, xtcp::ndi::ManualBackend& b,
+                           xtcp::XtcpStack& sa) {
+        Byte out[65536];
+        for (UInt32 round = 0; round < 50; ++round) {
+            bool moved = false;
+            while (0 != a.TxPending()) {
+                const UInt32 n = a.PollTx(out);
+                if (0 < n) {
+                    b.Inject(out, n, 0x0800);
+                    moved = true;
+                }
+            }
+            sa.PollAckTimers();
+            if (!moved) {
+                return;
+            }
+        }
+    }
+
+    static void PumpBoth(xtcp::ndi::ManualBackend& a, xtcp::ndi::ManualBackend& b,
+                         xtcp::XtcpStack& sa, xtcp::XtcpStack& sb) {
+        Byte out[65536];
+        for (UInt32 round = 0; round < 5000; ++round) {
+            bool moved = false;
+            while (0 != a.TxPending()) {
+                const UInt32 n = a.PollTx(out);
+                if (0 < n) {
+                    b.Inject(out, n, 0x0800);
+                    moved = true;
+                }
+            }
+            while (0 != b.TxPending()) {
+                const UInt32 n = b.PollTx(out);
+                if (0 < n) {
+                    a.Inject(out, n, 0x0800);
+                    moved = true;
+                }
+            }
+            sa.PollAckTimers();
+            sb.PollAckTimers();
+            if (!moved) {
+                return;
+            }
+        }
+    }
+
+    static UInt32 SnduNa(xtcp::XtcpStack& s, UInt64 conn) {
+        UInt32 a = 0, b = 0, c = 0, d = 0, e = 0, f = 0, g = 0, h = 0, i = 0;
+        UInt64 rto = 0;
+        UInt16 lp = 0, rp = 0;
+        s.ConnStats(conn, a, b, c, d, e, rto, f, g, h, i, lp, rp);
+        return i;
+    }
+}
+
+int main() {
+    xtcp::buf::InitPools();
+    {
+        xtcp::ndi::ManualBackend backend_a, backend_b;
+        xtcp::XtcpStack stack_a(&backend_a);
+        xtcp::XtcpStack stack_b(&backend_b);
+        backend_a.SetRxHandler([&stack_a](xtcp::ndi::Packet&& p) {
+            xtcp::buf::BufRef buf = xtcp::buf::BufRef::Acquire(p.len);
+            if (!buf.IsEmpty()) {
+                std::memcpy(buf.Data(), p.data, p.len);
+                buf.SetLen(p.len);
+                stack_a.OnPacket(std::move(buf));
+            }
+        });
+        backend_b.SetRxHandler([&stack_b](xtcp::ndi::Packet&& p) {
+            xtcp::buf::BufRef buf = xtcp::buf::BufRef::Acquire(p.len);
+            if (!buf.IsEmpty()) {
+                std::memcpy(buf.Data(), p.data, p.len);
+                buf.SetLen(p.len);
+                stack_b.OnPacket(std::move(buf));
+            }
+        });
+
+        xtcp::core::Endpoint local, remote;
+        local.family = 4;
+        local.addr[0] = 0x0A000001;
+        local.port = 40061;
+        remote.family = 4;
+        remote.addr[0] = 0x0A000002;
+        remote.port = 9090;
+        CHECK(stack_b.Listen(remote));
+        const UInt64 conn = stack_a.Connect(local, remote);
+        CHECK(0 != conn);
+        PumpBoth(backend_a, backend_b, stack_a, stack_b);
+        CHECK(xtcp::core::TcpState::kEstablished == stack_a.ConnectionState(conn));
+
+
+        Byte payload[12288];
+        std::memset(payload, 0x5A, sizeof(payload));
+        CHECK(stack_a.Send(conn, payload, sizeof(payload)));
+        PumpOneWay(backend_a, backend_b, stack_a);   // B's ACKs stay queued
+
+        // ---- s1: the same partial block, 3 dup-ACKs ----
+        const UInt32 una = SnduNa(stack_a, conn);
+        const UInt32 pair[2] = { una + 100, una + 600 };   // 500 bytes inside the first segment
+        CHECK(0 == stack_a.ConnSackedBytes(conn));
+        for (UInt32 i = 0; i < 3; ++i) {
+            std::vector<Byte> ack = BuildAckWithSack(una, pair, 1);
+            backend_a.Inject(ack.data(), static_cast<UInt32>(ack.size()), 0x0800);
+            CHECK(500 == stack_a.ConnSackedBytes(conn));   // idempotent
+        }
+        // An overlapping block extends coverage by the NEW bytes only.
+        const UInt32 pair2[2] = { una + 400, una + 800 };
+        {
+            std::vector<Byte> ack = BuildAckWithSack(una, pair2, 1);
+            backend_a.Inject(ack.data(), static_cast<UInt32>(ack.size()), 0x0800);
+        }
+        CHECK(700 == stack_a.ConnSackedBytes(conn));       // [100,800)
+        {
+            std::vector<Byte> ack = BuildAckWithSack(una, pair2, 1);
+            backend_a.Inject(ack.data(), static_cast<UInt32>(ack.size()), 0x0800);
+        }
+        CHECK(700 == stack_a.ConnSackedBytes(conn));
+        std::fprintf(stderr, "[sack_sb] s1 sacked bytes %llu\n",
+                     (unsigned long long)stack_a.ConnSackedBytes(conn));
+
+        // ---- s2: wrap-safe hole detection ----
+        {
+            const UInt32 base = 0xFFFFFF00u;
+            bool hole = false;
+            // block 1 straddles the wrap, block 2 starts past a hole
+            const UInt32 b1[2][2] = { { 0xFFFFFF00u, 0x00000040u }, { 0x00000100u, 0x00000200u } };
+            UInt64 c = xtcp::core::SackFrontierOffset(base, b1, 2, hole);
+            CHECK(hole);
+            CHECK(0x140 == c);
+            // contiguous across the wrap: no hole
+            const UInt32 b2[2][2] = { { 0xFFFFFF00u, 0x00000040u }, { 0x00000040u, 0x00000200u } };
+            c = xtcp::core::SackFrontierOffset(base, b2, 2, hole);
+            CHECK(!hole);
+            CHECK(0x300 == c);
+            // a lone block that starts after the wrap with a gap before it
+            const UInt32 b3[1][2] = { { 0x00000010u, 0x00000080u } };
+            c = xtcp::core::SackFrontierOffset(base, b3, 1, hole);
+            CHECK(hole);
+            // block starting exactly at una: covered, no hole
+            const UInt32 b4[1][2] = { { base, 0x00000020u } };
+            c = xtcp::core::SackFrontierOffset(base, b4, 1, hole);
+            CHECK(!hole);
+            CHECK(0x120 == c);
+            // wholly behind una: ignored
+            const UInt32 b5[1][2] = { { base - 0x200, base - 0x100 } };
+            c = xtcp::core::SackFrontierOffset(base, b5, 1, hole);
+            CHECK(!hole);
+            CHECK(0 == c);
+        }
+    }
+    xtcp::buf::ShutdownPools();
+    std::fprintf(stderr, g_failures ? "SACK_SCOREBOARD: FAILED (%d)\n" : "SACK_SCOREBOARD: ALL PASSED\n", g_failures);
+    return g_failures ? 1 : 0;
+}
