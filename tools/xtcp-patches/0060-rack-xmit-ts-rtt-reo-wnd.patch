+        /**
+         * @brief Contiguous SACK coverage above @a una, wrap-safe.
+         *
+         * Walks the blocks in wire order tracking the covered frontier as an
+         * OFFSET from @a una (mod 2^32), so blocks straddling the 2^32 wrap
+         * compare correctly. A block starting beyond the frontier proves a
+         * hole. Blocks wholly at/below @a una carry no information.
+         *
+         * @param una   Cumulative ACK point (snd_una_).
+         * @param sack  [left, right) edge pairs, wire order.
+         * @param count Number of valid pairs.
+         * @param has_hole Set true when a hole precedes some block.
+         * @return Frontier offset (bytes above @a una) after the walk.
+         */
+        inline UInt64 SackFrontierOffset(UInt32 una, const UInt32 (*sack)[2], Byte count,
+                                         bool& has_hole) noexcept {
+            UInt64 cursor = 0;
+            has_hole = false;
+            for (Byte b = 0; b < count; ++b) {
+                if (SeqLt(sack[b][1], una)) {
+                    continue;  // wholly behind the frontier
+                }
+                const UInt64 left = SeqLt(sack[b][0], una)
+                    ? 0 : static_cast<UInt64>(static_cast<UInt32>(sack[b][0] - una));
+                const UInt64 right = static_cast<UInt64>(static_cast<UInt32>(sack[b][1] - una));
+                if (cursor < left) {
+                    has_hole = true;
+                    break;
+                }
+                cursor = right;
+            }
+            return cursor;
+        }
