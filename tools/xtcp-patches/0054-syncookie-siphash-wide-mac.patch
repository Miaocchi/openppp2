+static void TestAllVerifiedBitsMatter() {
+    // 24 verified hash bits: flipping ANY of cookie bits [31..8] must be
+    // rejected (the previous layout verified only the top 5).
+    xtcp::core::Syncookies sc;
+    const UInt32 cookie = sc.Compute(0x0A000001, 0x0A000002, 50004, 8080, 0x50000000, 3449, 1);
+    Byte mss = 0;
+    CHECK(sc.Verify(cookie, cookie + 1, 0x0A000001, 0x0A000002, 50004, 8080, 0x50000000, 3449, 60, mss));
+    for (UInt32 bit = 8; bit < 32; ++bit) {
+        const UInt32 forged = cookie ^ (1u << bit);
+        CHECK(!sc.Verify(forged, forged + 1, 0x0A000001, 0x0A000002, 50004, 8080, 0x50000000, 3449, 60, mss));
+    }
+}
+
+static void TestMssIsAuthenticated() {
+    // The MSS index is covered by the hash: an attacker cannot re-encode
+    // a captured cookie with a different MSS.
+    xtcp::core::Syncookies sc;
+    const UInt32 cookie = sc.Compute(7, 8, 9, 10, 200, 777, 2);
+    Byte mss = 0;
+    for (UInt32 other = 0; other < 8; ++other) {
+        if (2 == other) {
+            continue;
+        }
+        const UInt32 forged = (cookie & ~7u) | other;
+        CHECK(!sc.Verify(forged, forged + 1, 7, 8, 9, 10, 200, 777, 60, mss));
+    }
+}
+
+static void TestFullIpv6AddressBound() {
+    // Every one of the 4 address words enters the hash (peers sharing a
+    // /32 or even a /96 prefix must not share cookies).
+    xtcp::core::Syncookies sc;
+    const UInt32 s[4] = { 0x20010db8, 1, 2, 3 };
+    const UInt32 d[4] = { 0x20010db8, 9, 9, 9 };
+    const UInt32 cookie = sc.Compute(s, d, 1000, 443, 42, 5000, 1);
+    Byte mss = 0;
+    CHECK(sc.Verify(cookie, cookie + 1, s, d, 1000, 443, 42, 5000, 60, mss));
+    for (UInt32 w = 0; w < 4; ++w) {
+        UInt32 s2[4] = { s[0], s[1], s[2], s[3] };
+        s2[w] ^= 0x100;
+        CHECK(!sc.Verify(cookie, cookie + 1, s2, d, 1000, 443, 42, 5000, 60, mss));
+        UInt32 d2[4] = { d[0], d[1], d[2], d[3] };
+        d2[w] ^= 0x100;
+        CHECK(!sc.Verify(cookie, cookie + 1, s, d2, 1000, 443, 42, 5000, 60, mss));
+    }
+}
