+    const UInt32 t1 = 100000;
+    const UInt32 cookie = sc.Compute(5, 6, 7, 8, 300, t1, 3);
+    Byte mss = 0;
+    CHECK(sc.Verify(cookie, cookie + 1, 5, 6, 7, 8, 300, t1 + 16, 400, mss));
+    CHECK(!sc.Verify(cookie, cookie + 1, 5, 6, 7, 8, 300, t1 + 512, 400, mss));
+    CHECK(!sc.Verify(cookie, cookie + 1, 5, 6, 7, 8, 300, t1 + 512 + 16, 400, mss));
+    // A cookie from the future relative to the verifier is rejected.
+    const UInt32 future = sc.Compute(5, 6, 7, 8, 300, t1 + 200, 3);
