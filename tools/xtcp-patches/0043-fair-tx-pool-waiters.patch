+            CHECK(!xtcp::buf::BufRef::Acquire(1500).IsEmpty());
+        }
+    }
+    {
+        xtcp::buf::TxAcquireScope scope(&busy);
+        CHECK(!xtcp::buf::BufRef::Acquire(1500).IsEmpty());
