+            while (!start.load(std::memory_order_acquire)) std::this_thread::yield();
+            for (unsigned i = 0; i < 2048; ++i) {
+                xtcp::buf::TxAcquireScope scope(&waiter);
+                auto ref = xtcp::buf::BufRef::Acquire(1500);
+                if (!ref.IsEmpty()) ++successes[id];
