+        xtcp::buf::TxAcquireScope scope(&busy);
+        auto ref = xtcp::buf::BufRef::Acquire(1500);
+        std::this_thread::yield();
+    }
+    for (auto& worker : workers) worker.join();
+    for (unsigned n : successes) CHECK(n > 0);
