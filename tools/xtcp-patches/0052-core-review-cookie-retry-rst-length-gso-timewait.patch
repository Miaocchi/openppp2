diff --git a/tmp/core-review-batch2/xtcp/tests/test_review_rst_exact.cpp b/tests/test_review_rst_exact.cpp
new file mode 100644
index 0000000..5505652
--- /dev/null
+++ b/tests/test_review_rst_exact.cpp
@@ -0,0 +1,61 @@
+#include <xtcp/core/tcp.h>
+#include <xtcp/core/gso.h>
+#include "harness/raw_pkt.h"
+#include <cstdio>
+
+int main() {
+    xtcp::buf::InitPools();
+    int failures = 0;
+    {
+        xtcp::core::Endpoint local, remote;
+        local.family = remote.family = 4;
+        local.addr[0] = 0x0a000002;
+        remote.addr[0] = 0x0a000001;
+        local.port = 8080;
+        remote.port = 40000;
+        for (auto state : {xtcp::core::TcpState::kEstablished, xtcp::core::TcpState::kFinWait2,
+                           xtcp::core::TcpState::kCloseWait, xtcp::core::TcpState::kClosing,
+                           xtcp::core::TcpState::kLastAck, xtcp::core::TcpState::kFinWait1}) {
+            unsigned replies = 0;
+            xtcp::core::TcpConn conn(state, local, remote, 1000, 2000,
+                [&](xtcp::buf::BufRef&&) { ++replies; });
+            auto rst = xtcp::harness::BuildIp4Tcp(remote.addr[0], local.addr[0],
+                remote.port, local.port, conn.RcvNxt() + 1, 0, 4);
+            conn.OnSegment(rst.data() + 20, rst.size() - 20, 100);
+            if (conn.State() != state || replies != 1) ++failures;
+            rst = xtcp::harness::BuildIp4Tcp(remote.addr[0], local.addr[0],
+                remote.port, local.port, conn.RcvNxt(), 0, 4);
+            conn.OnSegment(rst.data() + 20, rst.size() - 20, 200);
+            if (conn.State() != xtcp::core::TcpState::kClosed) ++failures;
+        }
+        xtcp::core::TcpConn tw(xtcp::core::TcpState::kTimeWait, local, remote, 1000, 2000,
+            [](xtcp::buf::BufRef&&) {});
+        tw.SetTwoMsl(1000);
+        tw.EnterTimeWait(100);
+        auto fin = xtcp::harness::BuildIp4Tcp(remote.addr[0], local.addr[0],
+            remote.port, local.port, tw.RcvNxt() - 1, 1001, 0x11);
+        tw.OnSegment(fin.data() + 20, fin.size() - 20, 200);
+        if (tw.TimeWaitDeadline() != 1200) ++failures;
+
+        std::vector<Byte> data(3000, 0x55);
+        auto super = xtcp::harness::BuildIp4Tcp(remote.addr[0], local.addr[0],
+            remote.port, local.port, 100, 200, 0xb8, data.data(), data.size());
+        super[39] = 1; // URG expires before the last segment.
+        auto owned = xtcp::buf::BufRef::Acquire(super.size());
+        std::memcpy(owned.Data(), super.data(), super.size());
+        owned.SetLen(super.size());
+        std::vector<xtcp::core::GsoSeg> segments;
+        if (!xtcp::core::GsoSegment(owned, 1460, segments) || segments.size() != 3) {
+            ++failures;
+        } else {
+            for (unsigned i = 0; i < segments.size(); ++i) {
+                const Byte* header = segments[i].hdr_ref.Data();
+                if (!!(header[33] & 0x80) != (i == 0)) ++failures;
+                if (header[33] & 0x20 || header[38] || header[39]) ++failures;
+            }
+        }
+    }
+    xtcp::buf::ShutdownPools();
+    std::printf("RST exact-match failures: %d\n", failures);
+    return failures ? 1 : 0;
+}
