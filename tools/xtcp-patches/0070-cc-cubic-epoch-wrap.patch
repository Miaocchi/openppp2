+static void TestCubicDeliveredReset() {
+    // A delivered counter that falls below the epoch/recovery base (reset
+    // by a migration restore while ca_priv persists) must not wrap the
+    // unsigned difference: the old code drove cnt to ~1e50 and spun forever
+    // in the decrement loop.
+    xtcp::cc::RegisterCubic();
+    const xtcp::cc::XtcpCongestionOps* ops = xtcp::cc::FindCongestionControl("cubic");
+    CHECK(NULLPTR != ops);
+    xtcp::cc::XtcpConnCc sk;
+    ops->init(&sk);
+    sk.mss = 1460;
+    sk.snd_cwnd = 100;
+    sk.delivered = 1000000;
+    sk.snd_ssthresh = ops->ssthresh(&sk);   // epoch_base = recovery_base = 1000000
+    sk.snd_cwnd = sk.snd_ssthresh;
+    // Leave recovery, then reset delivered underneath the plugin state.
+    sk.delivered = 1000000 + 100ull * 1460;
+    ops->cong_avoid(&sk, 0, 1460);
+    sk.delivered = 0;
+    const UInt32 before = sk.snd_cwnd;
+    for (int i = 0; i < 100; ++i) {
+        ops->cong_avoid(&sk, 0, 1460);      // must terminate
+    }
+    CHECK(sk.snd_cwnd >= before);
+    CHECK(sk.snd_cwnd <= before + 100);
+    // Recovery-base wrap: loss, then delivered reset while in recovery.
+    sk.delivered = 5000000;
+    sk.snd_ssthresh = ops->ssthresh(&sk);
+    sk.snd_cwnd = sk.snd_ssthresh;
+    sk.delivered = 0;
+    const UInt32 b2 = sk.snd_cwnd;
+    ops->cong_avoid(&sk, 0, 1460);
+    CHECK(sk.snd_cwnd == b2);               // still in recovery, no growth
+    // Absurd forward jump: growth per ACK stays bounded.
+    sk.delivered = 0x4000000000000000ull;
+    sk.snd_cwnd = 50;
+    sk.snd_ssthresh = 10;
+    ops->cong_avoid(&sk, 0, 1460);
+    CHECK(sk.snd_cwnd >= 50);
+    CHECK(sk.snd_cwnd <= 50 + 1000000 + 1);
+    ops->release(&sk);
+}
