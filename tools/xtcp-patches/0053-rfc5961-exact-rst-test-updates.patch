diff --git a/tests/test_seqwrap_rst.cpp b/tests/test_seqwrap_rst.cpp
index 3e6a4bc..4c5684d 100644
--- a/tests/test_seqwrap_rst.cpp
+++ b/tests/test_seqwrap_rst.cpp
@@ -107,8 +107,13 @@ static void TestInWindowRstCloses() {
         UInt32 tx = 0;
         xtcp::core::TcpConn conn = MakeWrapConn(&tx);
         InjectRst(conn, seq);
-        CHECK(TcpState::kClosed == conn.State());
-        CHECK(0 == tx);  // valid RST: no challenge ACK emitted
+        if (0xFFFFFFF0u == seq) {
+            // RFC 5961 3.2: only an exact RCV.NXT match closes.
+            CHECK(TcpState::kClosed == conn.State());
+            CHECK(0 == tx);  // valid RST: no challenge ACK emitted
+        } else {
+            CHECK(TcpState::kClosed != conn.State());  // in-window, inexact: challenge
+        }
     }
     std::fprintf(stderr, "[seqwrap-rst] in-window RSTs closed the connection at the wrap\n");
 }
@@ -171,7 +176,7 @@ static void TestConnectionConsistentAfterChallenge() {
 
     // rcv_nxt_ is now 0x00000003 (0xFFFFFFF0 + 16 wraps to 0, then +3);
     // an RST inside the post-wrap window closes the connection.
-    InjectRst(conn, 0x00000010u);
+    InjectRst(conn, 0x00000003u);
     CHECK(TcpState::kClosed == conn.State());
     std::fprintf(stderr, "[seqwrap-rst] connection consistent after boundary challenge\n");
 }
