diff --git a/tests/test_syn_option_layout.cpp b/tests/test_syn_option_layout.cpp
--- a/tests/test_syn_option_layout.cpp
+++ b/tests/test_syn_option_layout.cpp
@@ -0,0 +1,136 @@
+/**
+ * @file test_syn_option_layout.cpp
+ * @brief SYN / SYN+ACK option bytes must parse strictly (RFC 9293 3.2):
+ *        no End-of-Option-List byte before the last option, every option
+ *        length in bounds, and WSOPT present whenever both sides offer it -
+ *        with and without SACK-permitted.
+ */
+#include <xtcp/core/stack.h>
+#include <xtcp/ndi/manual.h>
+
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+static int g_failures = 0;
+
+#define CHECK(cond)                                                      \
+    do {                                                                 \
+        if (!(cond)) {                                                   \
+            std::fprintf(stderr, "FAIL %s:%d: %s\n", __FILE__, __LINE__, #cond); \
+            ++g_failures;                                                \
+        }                                                                \
+    } while (0)
+
+namespace {
+struct ParsedSyn {
+    bool syn = false;
+    bool ack = false;
+    bool strict_ok = true;  // no early EOL, all lengths in bounds
+    bool has_mss = false;
+    bool has_sack_perm = false;
+    bool has_wscale = false;
+    bool has_ts = false;
+};
+
+ParsedSyn ParseSyn(const Byte* p, UInt32 len) {
+    ParsedSyn out;
+    if (len < 40 || (p[0] >> 4) != 4) {
+        out.strict_ok = false;
+        return out;
+    }
+    const UInt32 ip = (p[0] & 0x0F) * 4u;
+    const Byte* t = p + ip;
+    const UInt32 hdr = (t[12] >> 4) * 4u;
+    out.syn = 0 != (t[13] & 0x02);
+    out.ack = 0 != (t[13] & 0x10);
+    for (UInt32 i = 20; i < hdr;) {
+        const Byte kind = t[i];
+        if (kind == 0) {
+            // EOL is only legal as trailing padding.
+            for (UInt32 k = i; k < hdr; ++k) {
+                if (t[k] != 0) out.strict_ok = false;
+            }
+            break;
+        }
+        if (kind == 1) {
+            ++i;
+            continue;
+        }
+        if (i + 1 >= hdr || t[i + 1] < 2 || i + t[i + 1] > hdr) {
+            out.strict_ok = false;
+            break;
+        }
+        if (kind == 2) out.has_mss = true;
+        if (kind == 4) out.has_sack_perm = true;
+        if (kind == 3) out.has_wscale = true;
+        if (kind == 8) out.has_ts = true;
+        i += t[i + 1];
+    }
+    return out;
+}
+
+void Deliver(xtcp::ndi::ManualBackend& from, xtcp::XtcpStack& to, ParsedSyn* syn,
+        ParsedSyn* syn_ack) {
+    Byte out[65536];
+    while (0 != from.TxPending()) {
+        const UInt32 n = from.PollTx(out);
+        if (0 == n) continue;
+        const ParsedSyn parsed = ParseSyn(out, n);
+        if (parsed.syn && !parsed.ack && NULLPTR != syn) *syn = parsed;
+        if (parsed.syn && parsed.ack && NULLPTR != syn_ack) *syn_ack = parsed;
+        xtcp::buf::BufRef buf = xtcp::buf::BufRef::Acquire(n);
+        std::memcpy(buf.Data(), out, n);
+        buf.SetLen(n);
+        to.OnPacket(std::move(buf));
+    }
+}
+
+void RunCase(bool no_sack, UInt16 port) {
+    xtcp::ndi::ManualBackend backend_a, backend_b;
+    xtcp::XtcpStack stack_a(&backend_a);
+    xtcp::XtcpStack stack_b(&backend_b);
+    stack_a.SetDefaultNoSack(no_sack);
+    xtcp::core::Endpoint local, remote;
+    local.family = 4;
+    local.addr[0] = 0x0A000001;
+    local.port = port;
+    remote.family = 4;
+    remote.addr[0] = 0x0A000002;
+    remote.port = 443;
+    CHECK(stack_b.Listen(remote));
+    const UInt64 conn = stack_a.Connect(local, remote);
+    CHECK(0 != conn);
+    ParsedSyn syn, syn_ack;
+    for (UInt32 i = 0; i < 50 && xtcp::core::TcpState::kEstablished != stack_a.ConnectionState(conn); ++i) {
+        Deliver(backend_a, stack_b, &syn, NULLPTR);
+        Deliver(backend_b, stack_a, NULLPTR, &syn_ack);
+        stack_a.PollAckTimers();
+        stack_b.PollAckTimers();
+    }
+    CHECK(xtcp::core::TcpState::kEstablished == stack_a.ConnectionState(conn));
+    CHECK(syn.syn && syn.strict_ok);
+    CHECK(syn_ack.syn && syn_ack.ack && syn_ack.strict_ok);
+    CHECK(syn.has_mss && syn.has_wscale);
+    CHECK(syn_ack.has_mss && syn_ack.has_wscale);
+    CHECK(syn.has_sack_perm == !no_sack);
+    CHECK(syn_ack.has_sack_perm == !no_sack);
+    CHECK(syn.has_ts == syn_ack.has_ts);
+    std::printf("[syn-options] no_sack=%d syn{strict=%d ws=%d ts=%d} synack{strict=%d ws=%d ts=%d}\n",
+        no_sack ? 1 : 0, syn.strict_ok ? 1 : 0, syn.has_wscale ? 1 : 0, syn.has_ts ? 1 : 0,
+        syn_ack.strict_ok ? 1 : 0, syn_ack.has_wscale ? 1 : 0, syn_ack.has_ts ? 1 : 0);
+}
+}  // namespace
+
+int main() {
+    xtcp::buf::InitPools();
+    RunCase(false, 40100);
+    RunCase(true, 40101);
+    xtcp::buf::ShutdownPools();
+    if (0 != g_failures) {
+        std::printf("SYN_OPTION_LAYOUT: FAILED (%d)\n", g_failures);
+        return 1;
+    }
+    std::printf("SYN_OPTION_LAYOUT: PASS\n");
+    return 0;
+}
