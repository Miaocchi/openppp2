+def record_pool_events(output: Path, clock: dict) -> None:
+    metric = re.compile(r"\[([^\]]+)\] COUNT \[(mux\.pool\.[\w.]+)\].*? delta=(-?\d+)\b")
+    with (output / "pool-events.ndjson").open("w") as events:
+        for role in ("client", "server"):
