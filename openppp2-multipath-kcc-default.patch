+                                  "end_monotonic_ms": int(finished * 1000),
+                                  "start_tbf_bytes": before[direction],
+                                  "end_tbf_bytes": after[direction],
+                                  "tbf_bytes": deltas,
+                                  "mbps": {path: count * 8 / (finished - started) / 1e6 if count is not None else None
